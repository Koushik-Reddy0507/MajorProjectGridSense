# GridSense Environment Configuration
# Copy to .env and fill in your actual values

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend Supabase (with service role key)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ==========================================
# EXTERNAL API KEYS
# ==========================================
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# DATABASE
# ==========================================
# Using Supabase connection pooler (Transaction mode)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:6543/postgres
REDIS_URL=redis://localhost:6379/0

# ==========================================
# ML & AI MODELS
# ==========================================
MAX_DATASET_SIZE_MB=500
ML_MODEL_CACHE_ENABLED=true
LANGRAPH_DEBUG=false

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_METABASE_INTEGRATION=true
ENABLE_OPENWEATHER_INTEGRATION=true
ENABLE_EXPERIMENTAL_FEATURES=false

# ==========================================
# METABASE (if using Metabase - no tokens needed)
# ==========================================
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@gridsense.io
METABASE_ADMIN_PASSWORD=change-me

# ==========================================
# EMAIL (for notifications - optional)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@gridsense.io

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=GridSense
VITE_APP_VERSION=1.0.0

# ==========================================
# ADVANCED OPTIONS
# ==========================================
# AI Provider (openai, anthropic, local)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY


# LLM for explanations
LLM_MODEL=gpt-4
